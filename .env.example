# ==============================
# GROQ API CONFIG
# ==============================
GROQ_API_KEY_1=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==============================a
# MODEL ROUTING
# ==============================
PRIMARY_MODEL=moonshotai/kimi-k2-instruct
FALLBACK_MODEL_1=llama-3.3-70b-versatile

# ==============================
# LLM RUNTIME CONTROLS
# ==============================
LLM_TIMEOUT_SECONDS=30
MAX_RETRIES=1

# ==============================
# SERVER CONFIG
# ==============================
SERVER_HOST=127.0.0.1
SERVER_PORT=8892
# Leave false for local-only FastAPI. Set true only for a trusted network deployment.
RESUMERANKER_ALLOW_NETWORK_EXPOSURE=false

# Filesystem access is disabled until this canonical root is configured.
RESUMERANKER_APPROVED_ROOT=
RESUMERANKER_MAX_SCAN_FILES=100
RESUMERANKER_MAX_FILE_BYTES=10485760
RESUMERANKER_MAX_FOLDER_BYTES=104857600
RESUMERANKER_MAX_JD_ENTRIES=5

# Resume/JD content is never sent to a provider unless this is explicitly enabled.
RESUMERANKER_ENABLE_LLM_CALLS=false
RESUMERANKER_MAX_LLM_CANDIDATES=5
# The legacy local shutdown endpoint is disabled by default.
RESUMERANKER_ENABLE_SHUTDOWN=false
